<UserControl x:Class="ShoroCraftLauncher.App.Views.ModsView"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ShoroCraftLauncher.App.ViewModels">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Mods_Profiles}" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent" BorderThickness="0"
                         DisplayMemberPath="Name">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="8,6" />
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#3D7FBF" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2A5A8F" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,0,18,0" Background="{StaticResource BackgroundBrush}" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Search bar -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="12">
                <WrapPanel Orientation="Horizontal" ItemWidth="200">
                    <ComboBox ItemsSource="{Binding SearchProviders}"
                              SelectedItem="{Binding SelectedProvider}"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Margin="0,0,8,8" MinWidth="150" />
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource SearchTextBox}"
                             Margin="0,0,8,8"
                             Tag="{DynamicResource Mods_SearchPlaceholder}"
                             MinWidth="200">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="{DynamicResource Mods_Search}" Command="{Binding SearchCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="16,8" Margin="0,0,0,8" />
                </WrapPanel>
            </Border>

            <!-- Action bar -->
            <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                <Button Content="{DynamicResource Mods_Installed}" Command="{Binding ShowInstalledCommand}"
                        Margin="0,0,10,10" Padding="14,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Installed">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Mods_Recommended}" Command="{Binding ShowRecommendedCommand}"
                        Margin="0,0,10,10" Padding="14,8">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveTab}" Value="Recommended">
                                    <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Mods_AddLocal}" Command="{Binding AddModCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" />
                <Button Content="{DynamicResource Mods_ImportModpack}" Command="{Binding ImportModpackCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" />
                <Button Content="{DynamicResource Mods_OpenFolder}" Command="{Binding OpenModsFolderCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                <Button Content="{DynamicResource Mods_CheckUpdates}" Command="{Binding CheckForUpdatesCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                <Button Command="{Binding UpdateAllCommand}" Margin="0,0,10,10">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                            <Setter Property="Content" Value="Actualizar Mods" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasUpdates}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{DynamicResource Mods_Refresh}" Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" />
            </WrapPanel>
            <ProgressBar Grid.Row="2" Height="4" Margin="0,0,0,12" IsIndeterminate="True"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                         Style="{StaticResource AccentProgressBar}" />
            <StackPanel Grid.Row="3" Margin="0,0,0,12">
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                <TextBlock Text="{Binding UpdateStatus}"
                           Foreground="{StaticResource SuccessBrush}"
                           Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StackPanel>

            <!-- Mods list / Search results -->
            <Grid Grid.Row="4">
                <ListBox ItemsSource="{Binding Mods}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FlushListBoxItem}"
                         Visibility="{Binding ShowSearchResults, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FlatCardBorder}" Margin="0,0,0,8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                            <TextBlock Text="{Binding ModVersion}" Style="{StaticResource CardSubtitle}" Margin="0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding MinecraftVersion, StringFormat='MC {0}'}" Style="{StaticResource CardSubtitle}" Margin="18,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}" Style="{StaticResource CardSubtitle}" Margin="18,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ToggleButton IsChecked="{Binding Status, Converter={StaticResource StatusToBoolConverter}}"
                                                      Style="{StaticResource SwitchToggle}" />
                                        <Button Content="{DynamicResource Mods_Delete}" Style="{StaticResource DangerButton}"
                                                Padding="10,5" FontSize="12" Margin="10,0,0,0"
                                                Command="{Binding ElementName=root, Path=DataContext.RemoveModCommand}"
                                                CommandParameter="{Binding Id}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Search Results -->
                <ListBox ItemsSource="{Binding SearchResults}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FlushListBoxItem}"
                         Visibility="{Binding ShowSearchResults, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FlatCardBorder}" Margin="0,0,0,8" Padding="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Grid.Column="0" Source="{Binding IconPath, Converter={StaticResource ImageSourceConverter}, ConverterParameter=40}" Width="40" Height="40"
                                           Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" />
                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" MaxHeight="30" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="{DynamicResource Mods_Install}" Style="{StaticResource PrimaryButton}"
                                            Padding="14,7" FontSize="12" VerticalAlignment="Center"
                                            Command="{Binding ElementName=root, Path=DataContext.InstallFromSearchCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
