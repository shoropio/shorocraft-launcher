<UserControl x:Class="ShoroCraftLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel>
            <TextBlock Text="Configuración" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Directorio de Minecraft" Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GameDir}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseGameDirCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" />
                                <Button Grid.Column="2" Content="Guardar" Command="{Binding SaveGameDirCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Padding="12,6" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Margin="0,0,0,12">
                            <TextBlock Text="Idioma" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding Language}" Width="200" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="16,0,0,12">
                            <TextBlock Text="Cerrar launcher al iniciar" Style="{StaticResource FormLabel}" />
                            <ToggleButton IsChecked="{Binding CloseOnLaunch}"
                                          Style="{StaticResource SwitchToggle}"
                                          HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="16,0,0,12">
                            <TextBlock Text="Mantener abierto después de jugar" Style="{StaticResource FormLabel}" />
                            <ToggleButton IsChecked="{Binding KeepOpen}"
                                          Style="{StaticResource SwitchToggle}"
                                          HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mantenimiento" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Content="Limpiar archivos temporales" Command="{Binding CleanTempCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                        <Button Content="Buscar actualizaciones" Command="{Binding CheckUpdatesCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Acerca de" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Launcher:" FontWeight="Bold" Margin="0,0,16,8" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="ShoroCraft Launcher" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Versión:" FontWeight="Bold" Margin="0,0,16,8" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LauncherVersion}" Margin="0,0,0,8" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Tamaño total:" FontWeight="Bold" Margin="0,0,16,8" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalSizeFormatted}" Margin="0,0,0,8" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
