<UserControl x:Class="ShoroCraftLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,18,0">
            <TextBlock Text="{DynamicResource Set_Title}" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set_General}" Style="{StaticResource CardTitle}" Margin="0,0,0,18" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="{DynamicResource Set_GameDir}" Style="{StaticResource FormLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding GameDir}" IsReadOnly="True" MinHeight="40" />
                        <Button Grid.Row="1" Grid.Column="1" Content="..." Command="{Binding BrowseGameDirCommand}"
                                Style="{StaticResource SecondaryButton}" Width="48" Margin="10,0,0,0" Padding="0" />
                        <Button Grid.Row="1" Grid.Column="2" Content="{DynamicResource Set_Save}" Command="{Binding SaveGameDirCommand}"
                                Style="{StaticResource PrimaryButton}" Width="96" Margin="10,0,0,0" Padding="0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="{DynamicResource Set_Language}" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding Language}"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      MinWidth="180" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <TextBlock Text="{DynamicResource Set_CloseOnLaunch}" Style="{StaticResource FormLabel}" />
                            <ToggleButton IsChecked="{Binding CloseOnLaunch}"
                                          Style="{StaticResource SwitchToggle}"
                                          HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Set_KeepOpen}" Style="{StaticResource FormLabel}" />
                            <ToggleButton IsChecked="{Binding KeepOpen}"
                                          Style="{StaticResource SwitchToggle}"
                                          HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set_CurseForgeTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                    <TextBlock Text="{DynamicResource Set_CurseForgeDesc}"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="{DynamicResource Set_CurseForgeKey}" Style="{StaticResource FormLabel}" />
                    <PasswordBox x:Name="CurseForgeKeyBox" MinHeight="40" PasswordChar="●"
                                 AutomationProperties.Name="CurseForge API key"
                                 PasswordChanged="CurseForgeKeyBox_PasswordChanged" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set_Maintenance}" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Content="{DynamicResource Set_CleanTemp}" Command="{Binding CleanTempCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                        <Button Content="{DynamicResource Set_CheckUpdates}" Command="{Binding CheckUpdatesCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                        <Button Content="{DynamicResource Set_OpenLogs}" Command="{Binding OpenLogsFolderCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                        <Button Content="{DynamicResource Set_ExportDiag}" Command="{Binding ExportDiagnosticsCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Set_About}" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="{DynamicResource Set_Launcher}" Style="{StaticResource FormLabel}" />
                            <TextBlock Text="ShoroCraft Launcher" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="{DynamicResource Set_Version}" Style="{StaticResource FormLabel}" />
                            <TextBlock Text="{Binding LauncherVersion}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Set_TotalSize}" Style="{StaticResource FormLabel}" />
                            <TextBlock Text="{Binding TotalSizeFormatted}" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                    <TextBlock Text="{DynamicResource Set_Copyright}"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
