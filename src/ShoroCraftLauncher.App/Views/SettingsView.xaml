<UserControl x:Class="ShoroCraftLauncher.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <TextBlock Text="Configuración" Style="{StaticResource SectionTitle}" />

            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource CardTitle}" Margin="0,0,0,18" />

                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="Directorio de Minecraft" Style="{StaticResource FormLabel}" />
                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding GameDir}" IsReadOnly="True" MinHeight="40" />
                        <Button Grid.Row="1" Grid.Column="1" Content="..." Command="{Binding BrowseGameDirCommand}"
                                Style="{StaticResource SecondaryButton}" Width="48" Margin="10,0,0,0" Padding="0" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Guardar" Command="{Binding SaveGameDirCommand}"
                                Style="{StaticResource PrimaryButton}" Width="96" Margin="10,0,0,0" Padding="0" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Text="Idioma" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding Language}"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                      MinWidth="180" HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <TextBlock Text="Cerrar al iniciar" Style="{StaticResource FormLabel}" />
                            <ToggleButton IsChecked="{Binding CloseOnLaunch}"
                                          Style="{StaticResource SwitchToggle}"
                                          HorizontalAlignment="Left" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Mantener abierto" Style="{StaticResource FormLabel}" />
                            <ToggleButton IsChecked="{Binding KeepOpen}"
                                          Style="{StaticResource SwitchToggle}"
                                          HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="APIs de mods" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                    <TextBlock Text="Modrinth funciona sin clave. CurseForge requiere una API key oficial."
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="CurseForge API key" Style="{StaticResource FormLabel}" />
                    <TextBox Text="{Binding CurseForgeApiKey, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="40" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Mantenimiento" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />
                    <WrapPanel>
                        <Button Content="Limpiar temporales" Command="{Binding CleanTempCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                        <Button Content="Buscar actualizaciones" Command="{Binding CheckUpdatesCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                        <Button Content="Abrir logs" Command="{Binding OpenLogsFolderCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                        <Button Content="Exportar diagnóstico" Command="{Binding ExportDiagnosticsCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Padding="22">
                <StackPanel>
                    <TextBlock Text="Acerca de" Style="{StaticResource CardTitle}" Margin="0,0,0,16" />
                    <UniformGrid Columns="3">
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Launcher" Style="{StaticResource FormLabel}" />
                            <TextBlock Text="ShoroCraft Launcher" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,18,0">
                            <TextBlock Text="Versión" Style="{StaticResource FormLabel}" />
                            <TextBlock Text="{Binding LauncherVersion}" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Tamaño total" Style="{StaticResource FormLabel}" />
                            <TextBlock Text="{Binding TotalSizeFormatted}" FontWeight="SemiBold" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
