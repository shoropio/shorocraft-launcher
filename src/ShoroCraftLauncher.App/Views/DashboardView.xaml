<UserControl x:Class="ShoroCraftLauncher.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,18,0">
            <!-- Profile Selector -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Perfil activo:" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Margin="0,0,10,0" />
                    <Button Grid.Column="2" Content="Aplicar" Command="{Binding ApplyProfileCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="20,8" FontSize="13" />
                </Grid>
            </Border>

            <!-- Update Banner -->
            <Border Padding="16" Margin="0,0,0,16"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLauncherUpdate}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⬆" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LauncherUpdateMessage}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="Descarga e instala la nueva versión automáticamente." Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="Instalar actualización" Command="{Binding DownloadLauncherUpdateCommand}"
                            IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="13" />
                </Grid>
            </Border>

            <!-- Stats Cards -->
            <Grid Margin="0,0,0,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="VERSIÓN" Style="{StaticResource StatLabel}" />
                        <TextBlock Grid.Row="1" Text="{Binding InstalledVersion}" Style="{StaticResource StatValue}" FontSize="22" />
                        <Rectangle Grid.Row="2" Height="3" Margin="0,10,0,0" RadiusX="0" RadiusY="0"
                                   Fill="{StaticResource PrimaryGradient}" />
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,8,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="MODS" Style="{StaticResource StatLabel}" />
                        <TextBlock Grid.Row="1" Text="{Binding ModsCount}" Style="{StaticResource StatValue}" FontSize="22" />
                        <Rectangle Grid.Row="2" Height="3" Margin="0,10,0,0" RadiusX="0" RadiusY="0"
                                   Fill="{StaticResource AccentBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource CardBorder}" Margin="8,0,8,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="RAM" Style="{StaticResource StatLabel}" />
                        <TextBlock Grid.Row="1" Text="{Binding AllocatedRam}" Style="{StaticResource StatValue}" FontSize="22" />
                        <Rectangle Grid.Row="2" Height="3" Margin="0,10,0,0" RadiusX="0" RadiusY="0"
                                   Fill="{StaticResource SuccessBrush}" />
                    </Grid>
                </Border>

                <Border Grid.Row="0" Grid.Column="3" Style="{StaticResource CardBorder}" Margin="8,0,0,0" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="ESTADO" Style="{StaticResource StatLabel}" />
                        <TextBlock Grid.Row="1" Text="{Binding ReadyStatus}" Style="{StaticResource StatValue}" FontSize="22"
                                   Foreground="{StaticResource SuccessBrush}" />
                        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Style="{StaticResource CardSubtitle}"
                                   TextWrapping="Wrap" MaxHeight="36" Margin="0,6,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Checklist Card & Repair -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Estado de preparación del perfil" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding ChecklistMessage}" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14" />
                        
                        <WrapPanel>
                            <!-- RAM checklist item -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock FontWeight="Bold" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌" />
                                            <Setter Property="Foreground" Value="#fff44336" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRamReady}" Value="True">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="#ff4caf50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Asignación de RAM" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Java checklist item -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock FontWeight="Bold" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌" />
                                            <Setter Property="Foreground" Value="#fff44336" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsJavaReady}" Value="True">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="#ff4caf50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Java recomendado" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Minecraft files checklist item -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock FontWeight="Bold" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌" />
                                            <Setter Property="Foreground" Value="#fff44336" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVersionReady}" Value="True">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="#ff4caf50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Archivos del juego" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Mod loader checklist item -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock FontWeight="Bold" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌" />
                                            <Setter Property="Foreground" Value="#fff44336" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoaderReady}" Value="True">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="#ff4caf50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="Cargador de mods (Loader)" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="Reparar perfil" Command="{Binding RepairProfileCommand}"
                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="16,10" FontSize="13" />
                </Grid>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Inicio rápido" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Instala loaders y versiones de Minecraft" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                                <WrapPanel>
                                <Button Content="Instalar Forge" Command="{Binding InstallLoaderCommand}"
                                    CommandParameter="Forge:latest"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="Instalar NeoForge" Command="{Binding InstallLoaderCommand}"
                                    CommandParameter="NeoForge:latest"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="Instalar Fabric" Command="{Binding InstallLoaderCommand}"
                                    CommandParameter="Fabric:latest"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="Instalar Quilt" Command="{Binding InstallLoaderCommand}"
                                    CommandParameter="Quilt:latest"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="{Binding IrisSodiumButtonText}"
                                    Command="{Binding InstallIrisCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="OptiFine (Manual)"
                                    Command="{Binding OptiFineInfoCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding AvailableVersions}"
                                          SelectedValue="{Binding SelectedVersion}"
                                          DisplayMemberPath="VersionId"
                                          SelectedValuePath="VersionId"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                          Width="200" Margin="0,0,10,0" />
                                <Button Content="Instalar versión" Command="{Binding InstallVersionCommand}"
                                        CommandParameter="{Binding SelectedVersion}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                                <Button Content="Actualizar lista" Command="{Binding RefreshVersionsCommand}"
                                        Style="{StaticResource SecondaryButton}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Value="{Binding DownloadProgress}" Style="{StaticResource AccentProgressBar}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Graphics & Performance Enhancements -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="Mejoras gráficas y rendimiento" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                    <TextBlock Text="Instala mods para mejorar la calidad visual y el rendimiento" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Content="{Binding IrisSodiumButtonText}" 
                                Command="{Binding InstallIrisCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"
                                ToolTip="Requiere un perfil Fabric. Si no está instalado, el botón se deshabilita." />
                        <Button Content="OptiFine (Manual)" 
                                Command="{Binding OptiFineInfoCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"
                                ToolTip="OptiFine no se descarga automáticamente; se abrirá la página oficial." />
                    </WrapPanel>
                    <TextBlock Text="Iris+Sodium está disponible solo para perfiles Fabric. OptiFine requiere descarga manual." 
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
