<UserControl x:Class="ShoroCraftLauncher.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ShoroCraftLauncher.App.Behaviors">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  behaviors:ScrollViewerWheelBehavior.BubbleWheel="True">
        <StackPanel Margin="0,0,18,0">
            <!-- Profile Selector -->
            <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{DynamicResource Dash_ActiveProfile}" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,14,0" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              DisplayMemberPath="Name"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                              Margin="0,0,10,0" />
                    <Button Grid.Column="2" Content="{DynamicResource Dash_Apply}" Command="{Binding ApplyProfileCommand}"
                            Style="{StaticResource PrimaryButton}" Padding="20,8" FontSize="13" />
                </Grid>
            </Border>

            <!-- Update Banner -->
            <Border Padding="16" Margin="0,0,0,16"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLauncherUpdate}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="⬆" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding LauncherUpdateMessage}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{DynamicResource Dash_UpdateAvailableMsg}" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                    <Button Grid.Column="2" Content="{DynamicResource Dash_InstallUpdate}" Command="{Binding DownloadLauncherUpdateCommand}"
                            IsEnabled="{Binding IsInstallingUpdate, Converter={StaticResource InverseBoolConverter}}"
                            Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="13" />
                </Grid>
            </Border>

            <!-- Minecraft Update Banner -->
            <Border Padding="16" Margin="0,0,0,16"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasUpdateNotification}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🚀" FontSize="22" VerticalAlignment="Center" Margin="0,0,14,0" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding UpdateNotificationMessage}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                        <TextBlock Text="{DynamicResource Dash_McUpdateMsg}" Style="{StaticResource CardSubtitle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="{DynamicResource Dash_Install}" Command="{Binding InstallMinecraftUpdateCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="18,8" FontSize="13" Margin="0,0,8,0" />
                        <Button Content="{DynamicResource Dash_Ignore}" Command="{Binding DismissMinecraftUpdateCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="18,8" FontSize="13" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Stats Cards -->
            <ItemsControl ItemsSource="{Binding StatCards}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="220" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,12,12" Padding="16" MinWidth="200">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding Label}" Style="{StaticResource StatLabel}" />
                                <TextBlock Grid.Row="1" Text="{Binding Value}" Style="{StaticResource StatValue}" FontSize="22" />
                                <Rectangle Grid.Row="2" Height="3" Margin="0,10,0,0" RadiusX="0" RadiusY="0"
                                           Fill="{Binding BarBrush}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Checklist Card & Repair -->
            <Border Style="{StaticResource CardBorder}" Padding="20" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{DynamicResource Dash_ChecklistTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding ChecklistMessage}" FontSize="14" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,14" />
                        
                        <!-- Loader update notification -->
                        <Border Background="#33FF9800" CornerRadius="0" Padding="10,7" Margin="0,0,0,10"
                                HorizontalAlignment="Left"
                                Visibility="{Binding HasLoaderUpdate, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LoaderUpdateMessage}" Foreground="#FFFF9800"
                                           FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                <Button Content="Actualizar" Command="{Binding UpdateLoaderCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                                        Padding="12,5" FontSize="12" Height="28" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        
                        <WrapPanel>
                            <!-- RAM checklist item -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock FontWeight="Bold" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌" />
                                            <Setter Property="Foreground" Value="#fff44336" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRamReady}" Value="True">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="#ff4caf50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource Dash_RamTitle}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Java checklist item -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock FontWeight="Bold" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌" />
                                            <Setter Property="Foreground" Value="#fff44336" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsJavaReady}" Value="True">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="#ff4caf50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource Dash_JavaTitle}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Minecraft files checklist item -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock FontWeight="Bold" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌" />
                                            <Setter Property="Foreground" Value="#fff44336" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVersionReady}" Value="True">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="#ff4caf50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource Dash_FilesTitle}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>

                            <!-- Mod loader checklist item -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,24,8">
                                <TextBlock FontWeight="Bold" Margin="0,0,6,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="❌" />
                                            <Setter Property="Foreground" Value="#fff44336" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoaderReady}" Value="True">
                                                    <Setter Property="Text" Value="✔" />
                                                    <Setter Property="Foreground" Value="#ff4caf50" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{DynamicResource Dash_LoaderTitle}" Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>

                    <Button Grid.Column="1" Content="{DynamicResource Dash_Repair}" Command="{Binding RepairProfileCommand}"
                            Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Padding="16,10" FontSize="13" />
                </Grid>
            </Border>

            <!-- Quick Actions -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash_QuickStart}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Dash_QuickStartSub}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                                <WrapPanel>
                                <Button Content="{DynamicResource Dash_InstallForge}" Command="{Binding InstallLoaderCommand}"
                                    CommandParameter="Forge:latest"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="{DynamicResource Dash_InstallNeoForge}" Command="{Binding InstallLoaderCommand}"
                                    CommandParameter="NeoForge:latest"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="{DynamicResource Dash_InstallFabric}" Command="{Binding InstallLoaderCommand}"
                                    CommandParameter="Fabric:latest"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="{DynamicResource Dash_InstallQuilt}" Command="{Binding InstallLoaderCommand}"
                                     CommandParameter="Quilt:latest"
                                     Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                </WrapPanel>
                            <WrapPanel Margin="0,6,0,0">
                                <ComboBox ItemsSource="{Binding AvailableVersions}"
                                          SelectedValue="{Binding SelectedVersion}"
                                          DisplayMemberPath="VersionId"
                                          SelectedValuePath="VersionId"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                                          MinWidth="200" Margin="0,0,10,10" />
                                <Button Content="{DynamicResource Dash_InstallVersion}" Command="{Binding InstallVersionCommand}"
                                        CommandParameter="{Binding SelectedVersion}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,10,10" />
                                <Button Content="{DynamicResource Dash_RefreshList}" Command="{Binding RefreshVersionsCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="0,0,0,10" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>

                    <ProgressBar Value="{Binding DownloadProgress}" Style="{StaticResource AccentProgressBar}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Graphics & Performance Enhancements -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash_PerfTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                    <TextBlock Text="{DynamicResource Dash_PerfSub}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <Button Command="{Binding InstallFabricIrisSodiumCommand}"
                                IsEnabled="{Binding IsIrisSodiumInstalled, Converter={StaticResource InverseBoolConverter}}"
                                Margin="0,0,10,10" Padding="16,10"
                                ToolTip="{DynamicResource Dash_FabricIrisSodiumTooltip}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                    <Setter Property="Content" Value="{DynamicResource Dash_FabricIrisSodium}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsIrisSodiumInstalled}" Value="True">
                                            <Setter Property="Content" Value="{DynamicResource Dash_FabricIrisSodiumInstalled}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{Binding IrisSodiumButtonText}" 
                                Command="{Binding InstallIrisCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"
                                ToolTip="{DynamicResource Dash_IrisTooltip}" />
                        <Button Content="{DynamicResource Dash_OptiFineManual}" 
                                Command="{Binding OptiFineInfoCommand}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,10,10"
                                ToolTip="{DynamicResource Dash_OptiFineTooltip}" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Dash_PerfNote}" 
                                Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Controller Support -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20"
                    Visibility="{Binding ShowControllerRecommendation, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash_ControllerTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                    <TextBlock Text="{DynamicResource Dash_ControllerSub}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <WrapPanel>
                        <Button Content="{Binding ControllerSupportButtonText}"
                                Command="{Binding InstallControllerSupportCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,10" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Dash_ControllerNote}"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- News Feed -->
            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Dash_NewsTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding NewsItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Padding="14" Margin="0,0,0,10"
                                        MouseLeftButtonUp="NewsItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="4" Height="40" CornerRadius="2"
                                                VerticalAlignment="Top" Margin="0,2,12,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Category}" Value="Servidor">
                                                            <Setter Property="Background" Value="#FFFF9800" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Category}" Value="Snapshot">
                                                            <Setter Property="Background" Value="#FF9C27B0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="White" />
                                            <TextBlock Text="{Binding Summary}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
