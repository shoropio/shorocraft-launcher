<Window x:Class="ShoroCraftLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ShoroCraftLauncher.App.ViewModels"
        Title="ShoroCraft Launcher"
        Icon="/Assets/icon.png"
        Width="1100" Height="700"
        MinWidth="900" MinHeight="550"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header / App Info -->
                    <Border Grid.Row="0" Padding="20,18,20,14"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="0" Width="38" Height="38" Margin="0,0,12,0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0" />
                                        <GradientStop Color="{StaticResource AccentColor}" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M 12,2 L 22,7 22,17 12,22 2,17 2,7 Z M 12,2 12,12 M 2,7 12,12 22,7" 
                                      Stroke="White" StrokeThickness="1.5" StrokeLineJoin="Round" 
                                      Stretch="Uniform" Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ShoroCraft" FontSize="17" FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}" />
                                <TextBlock Text="Launcher v1.0" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Navigation -->
                    <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                             Background="Transparent" BorderThickness="0"
                             SelectedValue="{Binding SelectedNav}"
                             SelectedValuePath="Name"
                             Margin="8,12,8,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:NavItem">
                                <Border x:Name="navItem" Padding="12,10" Background="Transparent" CornerRadius="0" Margin="0,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="16" Width="28"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name, Converter={StaticResource TranslationConverter}}" FontSize="13" FontWeight="Medium"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.Resources>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderThickness="0" CornerRadius="0"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.Resources>
                    </ListBox>

                    <!-- User Panel (compacto) -->
                    <Border Grid.Row="2" Padding="14,12"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,1,0,0">
                        <StackPanel>
                            <!-- Avatar compacto con datos -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="0"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                        ClipToBounds="True">
                                    <Image Source="{Binding SkinUrl}" Stretch="UniformToFill"
                                           Margin="2" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username, TargetNullValue='Sin sesión'}"
                                               FontSize="13" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding AuthStatus, Converter={StaticResource TranslationConverter}}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextMutedBrush}" />
                                </StackPanel>
                            </Grid>
                            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     FontSize="12" Padding="8,6" Margin="0,0,0,8" />
                            <Button Content="{DynamicResource User_LoginMicrosoft}" Command="{Binding LoginCommand}"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="12" Padding="14,7" Height="32" Margin="0,0,0,6" />
                            <Button Content="{DynamicResource User_LoginOffline}" Command="{Binding LoginOfflineCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="12" Padding="14,7" Height="32" Margin="0,0,0,6" />
                            <Button Content="Cerrar sesión" Command="{Binding LogoutCommand}"
                                    Style="{StaticResource DangerButton}"
                                    FontSize="12" Padding="14,7" Height="32" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Content -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundBrush}"
                    CornerRadius="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar -->
                    <Border Grid.Row="0" Padding="24,14" Background="Transparent"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedNav, Converter={StaticResource TranslationConverter}}" FontSize="20" FontWeight="Bold"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="|" Margin="14,0" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SelectedProfileName, Converter={StaticResource TranslationConverter}}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Border Background="{StaticResource CardBrush}" CornerRadius="0"
                                    Padding="12,6" Margin="0,0,8,0"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding GameVersionStatus}" />
                                </TextBlock>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area with fade-in transition -->
                <ContentControl Grid.Row="1" Content="{Binding CurrentView}"
                                Margin="24,16,24,8" />

                <!-- Status Bar / Bottom Bar -->
                <Border Grid.Row="2" Padding="24,12" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                                       Margin="0,0,0,2" />

                            <Grid Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Margin="0,2,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ProgressBar Grid.Row="0" Value="{Binding DownloadProgress}"
                                             Height="4" Margin="0,2"
                                             Style="{StaticResource AccentProgressBar}" />
                                <TextBlock Grid.Row="1" Text="{Binding DownloadStatus}"
                                           Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,2,0,0" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0">
                            <Button Content="{DynamicResource BottomBar_Play}" Command="{Binding LaunchGameCommand}"
                                    Style="{StaticResource PlayButton}"
                                    Visibility="{Binding IsGameRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}" />

                            <Button Content="{DynamicResource BottomBar_Stop}" Command="{Binding StopGameCommand}"
                                    Style="{StaticResource DangerButton}" FontSize="14" FontWeight="Bold"
                                    Padding="30,14"
                                    Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
