<Window x:Class="ShoroCraftLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ShoroCraftLauncher.App.ViewModels"
        Title="ShoroCraft Launcher"
        Icon="/Assets/icon.png"
        Width="1024" Height="650"
        MinWidth="800" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20,18" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Border CornerRadius="0" Width="38" Height="38" Margin="0,0,12,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#22D3EE" Offset="0" />
                                    <GradientStop Color="#818CF8" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="/Assets/icon.png" Width="26" Height="26" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ShoroCraft" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="Launcher v1.0" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                         Background="Transparent" BorderThickness="0"
                         SelectedValue="{Binding SelectedNav}"
                         SelectedValuePath="Name"
                         Margin="8,8,8,0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:NavItem">
                            <Border Padding="12,10" Background="Transparent" CornerRadius="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="17" Width="28"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- User Panel -->
                <Border Grid.Row="2" Padding="14,12"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <StackPanel>
                        <Border CornerRadius="0" Margin="0,0,0,10" Height="120" ClipToBounds="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#1A2235" Offset="0" />
                                    <GradientStop Color="#1E293B" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Image Source="{Binding SkinUrl}" Stretch="Uniform" Margin="0,4,0,0" />
                        </Border>
                        <TextBlock Text="Usuario" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="2,0,0,4" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="13" Padding="8,6" Margin="0,0,0,8" />
                        <Button Content="Autenticar" Command="{Binding LoginCommand}"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="12" Padding="10,6" Margin="0,0,0,4" />
                        <TextBlock Text="{Binding AuthStatus}" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="2,0,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Padding="16,12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedNav}" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="|" Margin="12,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedProfileName}" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="0"
                                Padding="10,6" Margin="0,0,8,0">
                            <TextBlock FontSize="12">
                                <Run Text="{Binding GameVersionStatus}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"
                            Margin="24" />

            <!-- Status Bar / Bottom Bar -->
            <Border Grid.Row="2" Padding="20,12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        
                        <Grid Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0" Value="{Binding DownloadProgress}" 
                                         Height="6" Margin="0,4"
                                         Style="{StaticResource ProgressBarStyle}" />
                            <TextBlock Grid.Row="1" Text="{Binding DownloadStatus}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                        <Button Content="¡ENTRAR AL JUEGO!" Command="{Binding LaunchGameCommand}"
                                Style="{StaticResource TLauncherPlayButton}"
                                Visibility="{Binding IsGameRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        
                        <Button Content="DETENER" Command="{Binding StopGameCommand}"
                                Style="{StaticResource DangerButton}" FontSize="16" FontWeight="Bold"
                                Padding="30,12"
                                Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
