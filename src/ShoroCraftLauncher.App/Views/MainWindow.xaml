<Window x:Class="ShoroCraftLauncher.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ShoroCraftLauncher.App.ViewModels"
        Title="ShoroCraft Launcher"
        Icon="/Assets/icon.png"
        Width="1024" Height="650"
        MinWidth="800" MinHeight="500"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="SingleBorderWindow"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo -->
                <Border Grid.Row="0" Padding="20" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/Assets/icon.png" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ShoroCraft" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}" />
                            <TextBlock Text="Launcher" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Navigation -->
                <ListBox Grid.Row="1" ItemsSource="{Binding NavItems}"
                         Background="Transparent" BorderThickness="0"
                         SelectedValue="{Binding SelectedNav}"
                         SelectedValuePath="Name">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:NavItem">
                            <Border Padding="16,12" Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="18" Width="30" />
                                    <TextBlock Text="{Binding Name}" FontSize="14"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Bottom section -->
                <Border Grid.Row="2" Padding="16"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Background="{StaticResource SidebarBrush}">
                    <StackPanel>
                    <Border CornerRadius="8" Background="{StaticResource CardBrush}" Margin="0,0,0,12"
                            Width="100" Height="140" HorizontalAlignment="Center">
                        <Image Source="{Binding SkinUrl}" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="Nombre de usuario" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,4" />
                    <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="12" Padding="6,4" Margin="0,0,0,8"
                             Background="{StaticResource CardBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1" />
                    <Button Content="Autenticar offline" Command="{Binding LoginCommand}"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="12" Padding="12,6" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding AuthStatus}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Bar -->
            <Border Grid.Row="0" Padding="16,12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedNav}" FontSize="20" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="|" Margin="12,0" Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SelectedProfileName}" FontSize="14"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                                Padding="10,6" Margin="0,0,8,0">
                            <TextBlock FontSize="12">
                                <Run Text="{Binding GameVersionStatus}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content Area -->
            <ContentControl Grid.Row="1" Content="{Binding CurrentView}"
                            Margin="24" />

            <!-- Status Bar / Bottom Bar -->
            <Border Grid.Row="2" Padding="20,12" Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"
                                   Margin="0,0,0,4" />
                        
                        <Grid Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ProgressBar Grid.Row="0" Value="{Binding DownloadProgress}" 
                                         Height="6" Margin="0,4"
                                         Style="{StaticResource ProgressBarStyle}" />
                            <TextBlock Grid.Row="1" Text="{Binding DownloadStatus}"
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0,0,0">
                        <Button Content="¡ENTRAR AL JUEGO!" Command="{Binding LaunchGameCommand}"
                                Style="{StaticResource TLauncherPlayButton}"
                                Visibility="{Binding IsGameRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        
                        <Button Content="DETENER" Command="{Binding StopGameCommand}"
                                Style="{StaticResource DangerButton}" FontSize="16" FontWeight="Bold"
                                Padding="30,12"
                                Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
