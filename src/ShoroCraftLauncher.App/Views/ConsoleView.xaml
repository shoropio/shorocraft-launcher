<UserControl x:Class="ShoroCraftLauncher.App.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Status indicator -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
            <WrapPanel>
                <Button Content="Limpiar" Command="{Binding ClearLogCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,7" FontSize="12" />
                <Button Content="Copiar" Command="{Binding CopyLogCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,7" FontSize="12" />
                <Button Content="Copiar errores" Command="{Binding CopyRelevantLogCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Padding="14,7" FontSize="12" />
                <ComboBox ItemsSource="{Binding LevelFilters}"
                          SelectedItem="{Binding SelectedLevel}"
                          Width="110" Margin="0,0,8,0"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                <ComboBox ItemsSource="{Binding ModuleFilters}"
                          SelectedItem="{Binding SelectedModule}"
                          Width="140" Margin="0,0,8,0"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" Margin="0,0,8,0" Tag="Filtrar texto..." />
                <Border Background="{StaticResource CardBrush}" CornerRadius="0"
                        Padding="12,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextMutedBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsGameRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Detenido" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                            <Setter Property="Text" Value="En ejecución" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" CornerRadius="0">
            <ListBox x:Name="ConsoleList"
                     ItemsSource="{Binding LogLines}"
                     Style="{StaticResource ConsoleListBox}"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling" />
        </Border>
    </Grid>
</UserControl>
