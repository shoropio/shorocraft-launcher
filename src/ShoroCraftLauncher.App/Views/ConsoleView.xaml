<UserControl x:Class="ShoroCraftLauncher.App.Views.ConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:ShoroCraftLauncher.App.Behaviors">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

<!-- Status indicator -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,12">
            <WrapPanel Orientation="Horizontal" ItemWidth="180">
                <Button Content="{DynamicResource Con_Clear}" Command="{Binding ClearLogCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="14,7" FontSize="12" />
                <Button Content="{DynamicResource Con_Copy}" Command="{Binding CopyLogCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="14,7" FontSize="12" />
                <Button Content="{DynamicResource Con_CopyErrors}" Command="{Binding CopyRelevantLogCommand}"
                        Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Padding="14,7" FontSize="12" />
                <ComboBox ItemsSource="{Binding LevelFilters}"
                          SelectedItem="{Binding SelectedLevel}"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          Margin="0,0,8,8" MinWidth="110" />
                <ComboBox ItemsSource="{Binding ModuleFilters}"
                          SelectedItem="{Binding SelectedModule}"
                          Style="{StaticResource DarkComboBox}"
                          ItemContainerStyle="{StaticResource DarkComboBoxItem}"
                          Margin="0,0,8,8" MinWidth="140" />
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource SearchTextBox}"
                         Margin="0,0,8,8" MinWidth="180"
                         Tag="{DynamicResource Con_Search}" />
                <Border Background="{StaticResource CardBrush}" CornerRadius="0"
                        Padding="12,7" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsGameRunning, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Ellipse Width="8" Height="8" Fill="{StaticResource TextMutedBrush}"
                                 Margin="0,0,8,0" VerticalAlignment="Center"
                                 Visibility="{Binding IsGameRunning, Converter={StaticResource InverseBoolToVisibilityConverter}}" />
                        <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{StaticResource Con_Stopped}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameRunning}" Value="True">
                                            <Setter Property="Text" Value="{StaticResource Con_Running}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </WrapPanel>
        </Border>

        <!-- Progress indicator -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16,14" Margin="0,0,0,12"
                Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ProgressBar Grid.Row="0" Grid.Column="0" Height="8"
                             Value="{Binding DownloadProgress}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Style="{StaticResource AccentProgressBar}"
                             VerticalAlignment="Center" />

                <TextBlock Grid.Row="0" Grid.Column="1" Margin="14,0,0,0"
                           Text="{Binding ProgressPercent}"
                           FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                           Margin="0,8,0,0" Text="{Binding ProgressText}"
                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}"
                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Con_Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,8" />
                <TextBox Grid.Row="1" x:Name="ConsoleBox"
                         Style="{StaticResource ConsoleTextBox}"
                         Text="{Binding FullLogText, Mode=OneWay}"
                         behaviors:ConsoleAutoScrollBehavior.Enabled="True"
                         IsReadOnly="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
