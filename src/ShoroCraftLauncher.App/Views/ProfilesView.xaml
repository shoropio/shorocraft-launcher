<UserControl x:Class="ShoroCraftLauncher.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ShoroCraftLauncher.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="Perfiles" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                
                <Button Grid.Row="1" Content="+ Nuevo Perfil" Command="{Binding CreateProfileCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" Padding="14,8" />
                
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="📥 Importar" Command="{Binding ImportProfileCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,6" FontSize="11" />
                    <Button Grid.Column="1" Content="📤 Exportar" Command="{Binding ExportProfileCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="8,6" FontSize="11" />
                </Grid>
                
                <ListBox Grid.Row="3" ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent" BorderThickness="0"
                         DisplayMemberPath="Name" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel>
                <TextBlock Text="Editar Perfil" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource CardBorder}" Padding="24" IsEnabled="{Binding IsProfileSelected}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Nombre del perfil" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding ProfileName}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="Versión de Minecraft" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding McVersion}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="Tipo" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding ProfileTypes}"
                                      SelectedItem="{Binding ProfileTypeValue}"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Asignación de RAM (MB)" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding MaxRam}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="15" />
                            </Grid>
                            <Slider Value="{Binding MaxRam}" Minimum="512" Maximum="16384" SmallChange="512" LargeChange="1024" Style="{StaticResource ModernSlider}" />
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="512 MB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Text="16 GB" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Resolución y Pantalla" Style="{StaticResource FormLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding WindowWidth}" Width="80" Margin="0,0,8,0" />
                                <TextBlock Text="x" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBox Text="{Binding WindowHeight}" Width="80" Margin="0,0,16,0" />
                                <CheckBox Content="Pantalla completa" IsChecked="{Binding IsFullscreen}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Carpeta de juego (Opcional)" Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GameDir}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseGameDirCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,6" FontSize="13" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Java Path (Opcional)" Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding JavaPath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseJavaCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,6" FontSize="13" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Versión del Loader (Opcional)" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding LoaderVersion}" />
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="Argumentos JVM adicionales (Opcional)" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding JvmArgs}" Height="70"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Padding="10,8" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <WrapPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <Button Content="Guardar" Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Width="110" />
                            <Button Content="Duplicar" Command="{Binding DuplicateProfileCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Width="110" />
                            <Button Content="Eliminar" Command="{Binding DeleteProfileCommand}"
                                    Style="{StaticResource DangerButton}" Margin="0,0,10,0" Width="110" />
                            <Button Content="Abrir carpeta" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource SecondaryButton}" Width="130" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Backups Card -->
                <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,16,0,0" IsEnabled="{Binding IsProfileSelected}">
                    <StackPanel>
                        <TextBlock Text="Copias de Seguridad" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                        <TextBlock Text="Crea, restaura y elimina copias de seguridad de los archivos del perfil (mundos, configuraciones o scripts)." 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Tipo de copia" Style="{StaticResource FormLabel}" />
                                <ComboBox ItemsSource="{Binding BackupTypesList}"
                                          SelectedItem="{Binding SelectedBackupType}"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                            </StackPanel>
                            
                            <Button Grid.Column="1" Content="Crear Copia" Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Padding="16,8" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="Actualizar Lista" Command="{Binding LoadBackupsCommand}"
                                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Padding="16,8" />
                        </Grid>
                        
                        <TextBlock Text="Copias guardadas:" Style="{StaticResource FormLabel}" Margin="0,0,0,8" />
                        
                        <!-- List of Backups -->
                        <ListBox ItemsSource="{Binding Backups}"
                                 SelectedItem="{Binding SelectedBackup}"
                                 Background="#151518" BorderBrush="#252528" BorderThickness="1"
                                 Height="180" Margin="0,0,0,16">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Background="#101012" CornerRadius="6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- Backup Actions -->
                        <WrapPanel>
                            <Button Content="Restaurar Copia Seleccionada" Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" Padding="16,8" />
                            <Button Content="Eliminar Copia" Command="{Binding DeleteBackupCommand}"
                                    Style="{StaticResource DangerButton}" Padding="16,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
