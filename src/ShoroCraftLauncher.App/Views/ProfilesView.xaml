<UserControl x:Class="ShoroCraftLauncher.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ShoroCraftLauncher.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0">
            <StackPanel>
                <TextBlock Text="Perfiles" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                <Button Content="Nuevo Perfil" Command="{Binding CreateProfileCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,16" />
                <ListBox ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent" BorderThickness="0"
                         DisplayMemberPath="Name"
                         Height="400" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
            <StackPanel>
                <TextBlock Text="Editar Perfil" Style="{StaticResource SectionTitle}" />

                <Border Style="{StaticResource CardBorder}" Padding="20" IsEnabled="{Binding IsProfileSelected}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Nombre del perfil" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding ProfileName}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="Versión de Minecraft" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding McVersion}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,12">
                            <TextBlock Text="Tipo" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding ProfileTypes}"
                                      SelectedItem="{Binding ProfileTypeValue}"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Asignación de RAM (MB)" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding MaxRam}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" />
                            </Grid>
                            <Slider Value="{Binding MaxRam}" Minimum="512" Maximum="16384" SmallChange="512" LargeChange="1024" Style="{StaticResource ModernSlider}" />
                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="512MB" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                <TextBlock Text="16GB" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Resolución y Pantalla" Style="{StaticResource FormLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding WindowWidth}" Width="80" Margin="0,0,8,0" />
                                <TextBlock Text="x" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding WindowHeight}" Width="80" Margin="0,0,16,0" />
                                <CheckBox Content="Pantalla completa" IsChecked="{Binding IsFullscreen}" Style="{StaticResource ModernCheckBox}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Carpeta de juego (Opcional - usa por defecto)" Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GameDir}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseGameDirCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Java Path (Opcional - usa autodetectado)" Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding JavaPath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseJavaCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="12,6" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Versión del Loader (Opcional - usa latest si está vacío)" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding LoaderVersion}" />
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,12">
                            <TextBlock Text="Argumentos JVM adicionales (Opcional)" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding JvmArgs}" Height="60"
                                     AcceptsReturn="True" TextWrapping="Wrap" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8" />

                        <WrapPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,8,0,0">
                            <Button Content="Guardar" Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Width="100" />
                            <Button Content="Duplicar" Command="{Binding DuplicateProfileCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Width="100" />
                            <Button Content="Eliminar" Command="{Binding DeleteProfileCommand}"
                                    Style="{StaticResource DangerButton}" Margin="0,0,8,8" Width="100" />
                            <Button Content="Abrir carpeta" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource SecondaryButton}" Width="120" Margin="0,0,0,8" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
