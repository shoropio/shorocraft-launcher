<UserControl x:Class="ShoroCraftLauncher.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ShoroCraftLauncher.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:behaviors="clr-namespace:ShoroCraftLauncher.App.Behaviors">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                
                <TextBlock Grid.Row="0" Text="{DynamicResource Prof_Profiles}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />

                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock Text="{DynamicResource Prof_Template}" Style="{StaticResource FormLabel}" />
                    <ComboBox ItemsSource="{Binding ProfileTemplates}"
                              SelectedItem="{Binding SelectedProfileTemplate, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              IsSynchronizedWithCurrentItem="True"
                              Style="{StaticResource DarkComboBox}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                </StackPanel>
                
                <Button Grid.Row="2" Content="{DynamicResource Prof_New}" Command="{Binding CreateProfileCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" Padding="14,8" />
                
                <Grid Grid.Row="3" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="{DynamicResource Prof_Import}" Command="{Binding ImportProfileCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Padding="8,6" FontSize="11"
                            ToolTip="{DynamicResource Prof_ImportTip}" />
                        <Button Grid.Column="1" Content="{DynamicResource Prof_Export}" Command="{Binding ExportProfileCommand}"
                            Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Padding="8,6" FontSize="11"
                            ToolTip="{DynamicResource Prof_ExportTip}" />
                </Grid>
                
                <ListBox Grid.Row="4" ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent" BorderThickness="0"
                         DisplayMemberPath="Name" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      behaviors:ScrollViewerWheelBehavior.BubbleWheel="True">
            <StackPanel Margin="0,0,18,0">
                <TextBlock Text="{DynamicResource Prof_EditTitle}" Style="{StaticResource SectionTitle}" />
                <ProgressBar Height="4" Margin="0,10,0,16" IsIndeterminate="True"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Style="{StaticResource AccentProgressBar}" />

                <Border Style="{StaticResource CardBorder}" Padding="24" IsEnabled="{Binding IsProfileSelected}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Prof_Name}" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding ProfileName}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,14">
                            <TextBlock Text="{DynamicResource Prof_McVersion}" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding McVersion}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,0,0,14">
                            <TextBlock Text="{DynamicResource Prof_Type}" Style="{StaticResource FormLabel}" />
                            <ComboBox ItemsSource="{Binding ProfileTypes}"
                                      SelectedItem="{Binding ProfileTypeValue}"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource Prof_Ram}" Style="{StaticResource FormLabel}" />
                                <TextBlock Grid.Column="1" Text="{Binding MaxRam}" Foreground="{StaticResource PrimaryBrush}" FontWeight="Bold" FontSize="15" />
                            </Grid>
                            <Slider Value="{Binding MaxRam}" Minimum="512" Maximum="16384" SmallChange="512" LargeChange="1024" Style="{StaticResource ModernSlider}" />
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="{DynamicResource Prof_512MB}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Left" />
                                <TextBlock Text="{DynamicResource Prof_16GB}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Prof_Res}" Style="{StaticResource FormLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox Text="{Binding WindowWidth}" Width="80" Margin="0,0,8,0" />
                                <TextBlock Text="{DynamicResource Prof_WidthHeight}" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{StaticResource TextMutedBrush}" />
                                <TextBox Text="{Binding WindowHeight}" Width="80" Margin="0,0,16,0" />
                                <CheckBox Content="{DynamicResource Prof_Fullscreen}" IsChecked="{Binding IsFullscreen}" Style="{StaticResource ModernCheckBox}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Prof_GameDir}" Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding GameDir}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseGameDirCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,6" FontSize="13" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Prof_JavaPath}" Style="{StaticResource FormLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding JavaPath}" IsReadOnly="True" />
                                <Button Grid.Column="1" Content="..." Command="{Binding BrowseJavaCommand}"
                                        Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Padding="14,6" FontSize="13" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Prof_LoaderVer}" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding LoaderVersion}" />
                        </StackPanel>

                        <StackPanel Grid.Row="7" Grid.ColumnSpan="2" Margin="0,0,0,14">
                            <TextBlock Text="{DynamicResource Prof_JvmArgs}" Style="{StaticResource FormLabel}" />
                            <TextBox Text="{Binding JvmArgs}" Height="70"
                                     AcceptsReturn="True" TextWrapping="Wrap"
                                     Padding="10,8" />
                        </StackPanel>

                        <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Text="{Binding StatusMessage}"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10" />

                        <WrapPanel Grid.Row="9" Grid.ColumnSpan="2" Margin="0,4,0,0">
                            <Button Content="{DynamicResource Prof_Save}" Command="{Binding SaveProfileCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Width="110" />
                            <Button Content="{DynamicResource Prof_Duplicate}" Command="{Binding DuplicateProfileCommand}"
                                    Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" Width="110" />
                            <Button Content="{DynamicResource Prof_Delete}" Command="{Binding DeleteProfileCommand}"
                                    Style="{StaticResource DangerButton}" Margin="0,0,10,0" Width="110" />
                            <Button Content="{DynamicResource Prof_OpenFolder}" Command="{Binding OpenFolderCommand}"
                                    Style="{StaticResource SecondaryButton}" Width="130" />
                        </WrapPanel>
                    </Grid>
                </Border>

                <!-- Backups Card -->
                <Border Style="{StaticResource CardBorder}" Padding="24" Margin="0,16,0,0" IsEnabled="{Binding IsProfileSelected}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Prof_BackupsTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,14" />
                        <TextBlock Text="{DynamicResource Prof_BackupsDesc}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap" />
                        
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{DynamicResource Prof_BackupType}" Style="{StaticResource FormLabel}" />
                                <ComboBox ItemsSource="{Binding BackupTypesList}"
                                          SelectedItem="{Binding SelectedBackupType}"
                                          Style="{StaticResource DarkComboBox}"
                                          ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                            </StackPanel>
                            
                            <Button Grid.Column="1" Content="{DynamicResource Prof_CreateBackup}" Command="{Binding CreateBackupCommand}"
                                    Style="{StaticResource PrimaryButton}" VerticalAlignment="Bottom" Padding="16,8" Margin="0,0,8,0" />
                            <Button Grid.Column="2" Content="{DynamicResource Prof_RefreshBackups}" Command="{Binding LoadBackupsCommand}"
                                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom" Padding="16,8" />
                        </Grid>
                        
                        <TextBlock Text="{DynamicResource Prof_SavedBackups}" Style="{StaticResource FormLabel}" Margin="0,0,0,8" />
                        
                        <!-- List of Backups -->
                        <ListBox ItemsSource="{Binding Backups}"
                                 SelectedItem="{Binding SelectedBackup}"
                                 Background="#151518" BorderBrush="#252528" BorderThickness="1"
                                 Height="180" Margin="0,0,0,16">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Background="#101012" CornerRadius="0">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding FilePath}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        
                        <!-- Backup Actions -->
                        <WrapPanel>
                            <Button Content="{DynamicResource Prof_RestoreBackup}" Command="{Binding RestoreBackupCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="0,0,12,0" Padding="16,8" />
                            <Button Content="{DynamicResource Prof_DeleteBackup}" Command="{Binding DeleteBackupCommand}"
                                    Style="{StaticResource DangerButton}" Padding="16,8" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
