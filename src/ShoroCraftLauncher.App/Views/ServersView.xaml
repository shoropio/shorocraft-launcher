<UserControl x:Class="ShoroCraftLauncher.App.Views.ServersView"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="{DynamicResource Srv_Title}" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                    <Button Content="{DynamicResource Srv_Refresh}" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="12" />
                </StackPanel>

                <ListBox x:Name="ServerList"
                         Grid.Row="1"
                         ItemsSource="{Binding Servers}"
                         SelectedItem="{Binding SelectedServer}"
                         Background="Transparent" BorderThickness="0"
                         ItemContainerStyle="{StaticResource FlushListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12" BorderBrush="#33FFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="14" />
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource CardSubtitle}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding MinecraftVersion}" Style="{StaticResource CardSubtitle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center"
                                            Background="#22FFFFFF" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <Button Content="{DynamicResource Srv_Start}" Command="{Binding StartServerCommand}"
                            CommandParameter="{Binding SelectedServer}"
                            Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                    <Button Content="{DynamicResource Srv_Stop}" Command="{Binding StopServerCommand}"
                            CommandParameter="{Binding SelectedServer}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                    <Button Content="{DynamicResource Srv_Wake}" Command="{Binding WakeServerCommand}"
                            CommandParameter="{Binding SelectedServer}"
                            Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                    <Button Content="{DynamicResource Srv_Delete}" Command="{Binding DeleteServerCommand}"
                            CommandParameter="{Binding SelectedServer}"
                            Style="{StaticResource DangerButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Srv_NewServer}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <WrapPanel>
                        <TextBox Text="{Binding NewServerName, UpdateSourceTrigger=PropertyChanged}"
                                 MinWidth="180" Margin="0,0,8,8" Tag="{DynamicResource Srv_Name}" />
                        <ComboBox ItemsSource="{Binding ServerTypes}"
                                  SelectedItem="{Binding SelectedServerType}"
                                  MinWidth="120" Margin="0,0,8,8"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                        <ComboBox ItemsSource="{Binding AvailableVersions}"
                                  SelectedItem="{Binding SelectedVersion}"
                                  MinWidth="130" Margin="0,0,8,8"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                        <TextBox Text="{Binding MaxRamMB}" MinWidth="90" Margin="0,0,8,8" Tag="{DynamicResource Srv_RamMB}" />
                        <Button Content="{DynamicResource Srv_Create}" Command="{Binding CreateServerCommand}"
                                Style="{StaticResource PrimaryButton}" Padding="20,10" Margin="0,0,0,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    <Border Margin="0,8,0,0"
                            Background="#22FFFFFF" CornerRadius="6" Padding="12,8"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar Width="200" Height="6" Value="{Binding DownloadProgress}"
                                         Style="{StaticResource AccentProgressBar}" />
                            <TextBlock Text="{Binding DownloadStatus}" FontSize="11" Margin="10,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Server connection info -->
            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Srv_ConnectionTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                    <WrapPanel Orientation="Horizontal">
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource Srv_LocalIp}" Style="{StaticResource CardSubtitle}" />
                            <TextBlock Text="{Binding LocalAddress}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="{DynamicResource Srv_PublicIp}" Style="{StaticResource CardSubtitle}" />
                            <TextBlock Text="{Binding PublicAddress, TargetNullValue='—'}" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                        <Button Content="{DynamicResource Srv_CopyAddress}" Command="{Binding CopyAddressCommand}"
                                Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="12"
                                VerticalAlignment="Bottom" />
                    </WrapPanel>
                    <TextBlock Text="{DynamicResource Srv_ConnectionNote}" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Plugins (Paper only) -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12"
                    Visibility="{Binding ShowPlugins, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Srv_PluginsTitle}" Style="{StaticResource CardTitle}" Margin="0,0,0,4" />
                    <TextBlock Text="{DynamicResource Srv_PluginsSub}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding ServerPlugins}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource FlatCardBorder}" Margin="0,0,0,8" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Text="{Binding Version}" />
                                                <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}" Text="{DynamicResource Srv_PluginDisabled}" Margin="6,0,0,0"
                                                           Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <ToggleButton IsChecked="{Binding IsDisabled, Converter={StaticResource InverseBoolConverter}}"
                                                          Style="{StaticResource SwitchToggle}" />
                                            <Button Padding="12,6" FontSize="12" Margin="6,0,0,0"
                                                    Command="{Binding ElementName=root, Path=DataContext.TogglePluginCommand}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                                        <Setter Property="Content" Value="{DynamicResource Srv_PluginDisable}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDisabled}" Value="True">
                                                                <Setter Property="Content" Value="{DynamicResource Srv_PluginEnable}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Padding="12,6" FontSize="12" Margin="6,0,0,0"
                                                    Command="{Binding ElementName=root, Path=DataContext.DeletePluginCommand}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"
                                                    Content="{DynamicResource Srv_PluginDelete}" />
                                            <Button Padding="12,6" FontSize="12" Margin="6,0,0,0"
                                                    Command="{Binding ElementName=root, Path=DataContext.InstallPluginCommand}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                                        <Setter Property="Content" Value="{DynamicResource Srv_PluginInstall}" />
                                                        <Setter Property="IsEnabled" Value="True" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                <Setter Property="Content" Value="{DynamicResource Srv_PluginInstalled}" />
                                                                <Setter Property="IsEnabled" Value="False" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasUpdate}" Value="True">
                                                                <Setter Property="Content" Value="{DynamicResource Srv_PluginUpdate}" />
                                                                <Setter Property="IsEnabled" Value="True" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="0" CornerRadius="0" MinHeight="240">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0D0D18">
                        <StackPanel Orientation="Horizontal" Margin="10,6">
                            <Button Content="{DynamicResource Srv_CopyConsole}" Command="{Binding CopyConsoleCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource Srv_ClearConsole}" Command="{Binding ClearConsoleCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" />
                        </StackPanel>
                    </Grid>
                        <Grid DockPanel.Dock="Bottom" Background="#0A0A14" Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ConsoleTextBox}" IsReadOnly="False"
                                     BorderThickness="0,1,0,0" BorderBrush="#222233" Padding="12,10"
                                     KeyDown="CommandBox_KeyDown"
                                     VerticalScrollBarVisibility="Disabled" />
                            <Button Grid.Column="1" Content="{DynamicResource Srv_Send}" Command="{Binding SendCommandCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Padding="16,8" FontSize="12"
                                    VerticalAlignment="Stretch" />
                    </Grid>
                    <ListBox x:Name="ServerConsole"
                             ItemsSource="{Binding LogLines}"
                             Style="{StaticResource ConsoleListBox}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
