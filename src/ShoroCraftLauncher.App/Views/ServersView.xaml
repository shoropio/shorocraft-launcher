<UserControl x:Class="ShoroCraftLauncher.App.Views.ServersView"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="Servidores" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                    <Button Content="Actualizar" Command="{Binding RefreshCommand}"
                            Style="{StaticResource SecondaryButton}" Padding="14,7" FontSize="12" />
                </StackPanel>

                <ListBox x:Name="ServerList"
                         DockPanel.Dock="Top"
                         ItemsSource="{Binding Servers}"
                         SelectedItem="{Binding SelectedServer}"
                         Background="Transparent" BorderThickness="0"
                         Height="380"
                         ItemContainerStyle="{StaticResource FlushListBoxItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8" Padding="12" BorderBrush="#33FFFFFF">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource CardTitle}" FontSize="14" />
                                        <TextBlock Text="{Binding Type}" Style="{StaticResource CardSubtitle}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding MinecraftVersion}" Style="{StaticResource CardSubtitle}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" VerticalAlignment="Center"
                                            Background="#22FFFFFF" CornerRadius="4" Padding="8,4">
                                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <ScrollViewer DockPanel.Dock="Bottom" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Button Content="Iniciar" Command="{Binding StartServerCommand}"
                                CommandParameter="{Binding SelectedServer}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,0,8" />
                        <Button Content="Detener" Command="{Binding StopServerCommand}"
                                CommandParameter="{Binding SelectedServer}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                        <Button Content="Despertar" Command="{Binding WakeServerCommand}"
                                CommandParameter="{Binding SelectedServer}"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,0,8" />
                        <Button Content="Eliminar" Command="{Binding DeleteServerCommand}"
                                CommandParameter="{Binding SelectedServer}"
                                Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Nuevo servidor" Style="{StaticResource CardTitle}" Margin="0,0,0,10" />
                        <WrapPanel>
                            <TextBox Text="{Binding NewServerName, UpdateSourceTrigger=PropertyChanged}"
                                     Width="180" Margin="0,0,8,8" Tag="Nombre" />
                            <ComboBox ItemsSource="{Binding ServerTypes}"
                                      SelectedItem="{Binding SelectedServerType}"
                                      Width="120" Margin="0,0,8,8"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                            <ComboBox ItemsSource="{Binding AvailableVersions}"
                                      SelectedItem="{Binding SelectedVersion}"
                                      Width="130" Margin="0,0,8,8"
                                      Style="{StaticResource DarkComboBox}"
                                      ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
                            <TextBox Text="{Binding MaxRamMB}" Width="90" Margin="0,0,8,8" Tag="RAM MB" />
                            <Button Content="Crear" Command="{Binding CreateServerCommand}"
                                    Style="{StaticResource PrimaryButton}" Padding="20,10" Margin="0,0,0,8" />
                        </WrapPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0"
                            Background="#22FFFFFF" CornerRadius="6" Padding="12,8"
                            Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibilityConverter}}">
                        <StackPanel>
                            <ProgressBar Width="160" Height="6" Value="{Binding DownloadProgress}"
                                         Style="{StaticResource AccentProgressBar}" />
                            <TextBlock Text="{Binding DownloadStatus}" FontSize="11" Margin="0,6,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="0" CornerRadius="0">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="#0D0D18">
                        <StackPanel Orientation="Horizontal" Margin="10,6">
                            <Button Content="Copiar consola" Command="{Binding CopyConsoleCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" Margin="0,0,8,0" />
                            <Button Content="Limpiar" Command="{Binding ClearConsoleCommand}"
                                    Style="{StaticResource SecondaryButton}" Padding="12,5" FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Bottom" Background="#0A0A14" Margin="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding CommandText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ConsoleTextBox}" IsReadOnly="False"
                                 BorderThickness="0,1,0,0" BorderBrush="#222233" Padding="12,10"
                                 KeyDown="CommandBox_KeyDown"
                                 VerticalScrollBarVisibility="Disabled" />
                        <Button Grid.Column="1" Content="Enviar" Command="{Binding SendCommandCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="10" Padding="16,8" FontSize="12" />
                    </Grid>
                    <ListBox x:Name="ServerConsole"
                             ItemsSource="{Binding LogLines}"
                             Style="{StaticResource ConsoleListBox}"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling" />
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
