<UserControl x:Class="ShoroCraftLauncher.App.Views.ScriptsView"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,12,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Scripts_Profiles}" Style="{StaticResource CardTitle}" Margin="0,0,0,12" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}"
                         SelectedItem="{Binding SelectedProfile}"
                         Background="Transparent" BorderThickness="0"
                         DisplayMemberPath="Name" />

                <TextBlock Grid.Row="2" Text="{DynamicResource Scripts_Title}" Style="{StaticResource CardTitle}" Margin="0,18,0,12" />
                <Button Grid.Row="3" Content="{DynamicResource Scripts_Import}" Command="{Binding ImportScriptCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,0,10" Padding="14,8" />
                <ListBox Grid.Row="4" ItemsSource="{Binding Scripts}"
                         SelectedItem="{Binding SelectedScript}"
                         Background="Transparent" BorderThickness="0"
                         DisplayMemberPath="Name" />
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="0,0,18,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="{Binding SelectedScript.Name, TargetNullValue={StaticResource Scripts_SelectPlaceholder}}"
                           Style="{StaticResource CardTitle}" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" Text="{Binding StatusMessage}"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6" />

            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" CornerRadius="0">
                <TextBox Text="{Binding ScriptContent, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource ConsoleTextBox}"
                         IsReadOnly="False"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         FontSize="13" />
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="{DynamicResource Scripts_SaveBackup}" Command="{Binding SaveScriptCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" />
                <Button Content="{DynamicResource Scripts_Delete}" Command="{Binding DeleteScriptCommand}"
                        Style="{StaticResource DangerButton}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
