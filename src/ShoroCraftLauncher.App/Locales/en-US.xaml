<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">
    
    <!-- Sidebar -->
    <system:String x:Key="Nav_Dashboard">Dashboard</system:String>
    <system:String x:Key="Nav_Profiles">Profiles</system:String>
    <system:String x:Key="Nav_Mods">Mods</system:String>
    <system:String x:Key="Nav_ResourcePacks">Resource Packs</system:String>
    <system:String x:Key="Nav_ShaderPacks">Shaders</system:String>
    <system:String x:Key="Nav_Scripts">Scripts</system:String>
    <system:String x:Key="Nav_Maps">Maps</system:String>
    <system:String x:Key="Nav_Console">Console</system:String>
    <system:String x:Key="Nav_Settings">Settings</system:String>
    
    <!-- User Panel -->
    <system:String x:Key="User_NotAuthenticated">Not Authenticated</system:String>
    <system:String x:Key="User_Offline">Offline</system:String>
    <system:String x:Key="User_LoginMicrosoft">Microsoft</system:String>
    <system:String x:Key="User_LoginOffline">Offline</system:String>
    
